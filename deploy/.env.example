# Copy to deploy/.env and change every value marked CHANGE-ME. Never commit deploy/.env.
POSTGRES_PASSWORD=CHANGE-ME-long-random
GRAFANA_ADMIN_PASSWORD=CHANGE-ME-long-random
# Required for every change (add/edit/delete channels, uploads): Authorization: Bearer <token>,
# or the 🔑 button in the web UI. Generate: openssl rand -hex 32
STT_API_TOKEN=CHANGE-ME-openssl-rand-hex-32

# Optional
# STT_CONFIG=config/server-cpu.yaml   # or your own copy in config/
# STT_API_PORT=8000
# GRAFANA_PORT=3000
# GRAFANA_ANONYMOUS_VIEW=false        # true = anyone reaching :3000 can view dashboards
# POSTGRES_PORT=5432                  # bound to 127.0.0.1 only
# REDIS_PORT=6379                     # bound to 127.0.0.1 only
# STT_CPU_THREADS=8                   # CPU image: physical cores
# STT_GPU_INDEX=0                     # GPU image: which GPU
# STT_ARCHIVE_HOURS=24                # video kept for time-range replay; ≈ 1.1 GB per channel-hour at 2.5 Mb/s (0 = off)
# STT_UPLOAD_MAX_MB=4096              # largest file accepted by "Upload video"
# HF_TOKEN=                           # optional: faster model downloads from Hugging Face
