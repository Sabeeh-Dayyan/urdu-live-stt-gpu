#!/usr/bin/env bash
# Run the CLI from source. (macOS can flag .venv files "hidden", which makes Python skip the
# editable-install .pth file; PYTHONPATH avoids depending on it.)
here="$(cd "$(dirname "$0")" && pwd)"
export PYTHONPATH="$here/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$here/.venv/bin/python" -m live_stt.cli "$@"
